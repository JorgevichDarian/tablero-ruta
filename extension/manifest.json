{
  "manifest_version": 3,
  "name": "Tablero de ruta · Logística Total",
  "short_name": "Tablero de ruta",
  "version": "1.8.1",
  "description": "Trae los datos de Nextbyn y Chess para el reporte externo del Tablero de ruta.",
  "key": "",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://portal.nextbyn.com/*",
    "https://logisticatotal.chesserp.com/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "bg.js" },
  "action": { "default_title": "Abrir el Tablero de ruta" },
  "externally_connectable": { "matches": ["https://darianjorgevich.github.io/*"] },
  "icons": { "16": "icono16.png", "48": "icono48.png", "128": "icono128.png" }
}
